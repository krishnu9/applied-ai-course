# Supabase Auth — public values only.
# Copy this file to `.env.local` and replace the placeholders with the Project
# URL and the public `anon` key from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# This app never uses a service-role key. Do not add one.
